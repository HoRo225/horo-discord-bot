# Discord（Token 請勿提交或貼到對話）
DISCORD_TOKEN=
DEV_GUILD_ID=

# 只接受 SQLite。全專案的冪等與配額保證建立在 SQLite 的寫入序列化上，
# 換成其他後端會靜默失去這些保證，因此程式啟動時會直接拒絕。
DATABASE_URL=sqlite+aiosqlite:///./data/horo.db

# 9Router 的 OpenAI-compatible 端點；ninerouter 是 compose 內的服務名稱。
AI_BASE_URL=http://ninerouter:20128/v1
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT=45
AI_MAX_RETRIES=2
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_RESPONSE_CHARS=8000
AI_RATE_LIMIT_SECONDS=5

LOG_LEVEL=INFO

# 9Router 管理介面的綁定位址。留空只綁 127.0.0.1（本機才連得到）；
# 填本機的 Tailscale IP 才會對 tailnet 開放。切勿填 0.0.0.0，
# 那會連同區網一起開放，且 Docker 會繞過 ufw 擋不住。
NINEROUTER_BIND_ADDR=
