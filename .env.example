# Discord（Token 請勿提交或貼到對話）
DISCORD_TOKEN=
DEV_GUILD_ID=

# SQLite 為預設值；切換 PostgreSQL 時只需更換此連線字串與安裝 async driver。
DATABASE_URL=sqlite+aiosqlite:///./data/crystalline_swan.db

# 同機 9Router 的 OpenAI-compatible 端點
AI_BASE_URL=http://host.docker.internal:9000/v1
AI_API_KEY=
AI_DEFAULT_MODEL=
AI_REQUEST_TIMEOUT=45
AI_MAX_RETRIES=2
AI_MAX_CONTEXT_MESSAGES=20
AI_MAX_CONTEXT_CHARS=12000
AI_MAX_RESPONSE_CHARS=8000
AI_RATE_LIMIT_SECONDS=5

LOG_LEVEL=INFO
